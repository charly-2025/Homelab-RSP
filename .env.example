# Tailscale MagicDNS hostname of the Raspberry Pi (e.g. homelab.tailxxxxxx.ts.net).
# Used by nginx, Nextcloud and Vaultwarden.
HOMELAB_HOST=your-machine.your-tailnet.ts.net

# MAC address of the computer to wake up.
PC_MAC=AA:BB:CC:DD:EE:FF

# Tailscale URL of the PC Agent.
PC_AGENT_URL=http://100.x.x.x:3000

# API token used to authenticate requests.
WOL_API_TOKEN=your_secure_token

# Wake-on-LAN method: etherwake or wakeonlan.
WOL_METHOD=etherwake

# Pi-hole web interface password.
PIHOLE_PASSWORD=your_pihole_password

# Time zone.
TZ=Europe/Paris
